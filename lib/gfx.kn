// Kiln standard graphics library — software renderer + OS window via C shim.
// Windows: Win32 + StretchDIBits. Linux: X11.
// The message loop / WndProc lives in runtime/kiln_gfx.c (see that file).

module gfx

@link("kiln_gfx")
extern fn kgfx_open(title: CStr, w: I32, h: I32, scale: I32) -> I32
@link("kiln_gfx")
extern fn kgfx_running() -> I32
@link("kiln_gfx")
extern fn kgfx_present(pixels: Ptr, w: I32, h: I32)
@link("kiln_gfx")
extern fn kgfx_key_down(key: I32) -> I32
@link("kiln_gfx")
extern fn kgfx_key_pressed(key: I32) -> I32
@link("kiln_gfx")
extern fn kgfx_time_ms() -> I64
@link("kiln_gfx")
extern fn kgfx_sleep_ms(ms: I32)
@link("kiln_gfx")
extern fn kgfx_close()

// ---- key constants (match kiln_gfx.c) ----
