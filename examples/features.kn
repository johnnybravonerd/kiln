// features.kn - a tour of the supported language subset

const LIMIT = 5
var calls = 0

fn classify(n: Int) -> Str {
    calls += 1
    match n {
        0 => "zero"
        1..=9 => "digit"
        x when x < 0 => "negative"
        _ => "large"
    }
}

fn grade(score: Int) -> Str {
    if score >= 90 { "A" } else if score >= 80 { "B" } else if score >= 70 { "C" } else { "F" }
}

fn first_even(xs: [Int]) -> Int {
    for x in xs {
        if x % 2 == 0 { return x }
    }
    -1
}

fn safe_div(a: Int, b: Int) -> Int {
    guard b != 0 else { return 0 }
    a / b
}

fn area(r: Float) -> Float = 3.14159 * r * r      // single-expression function

fn main() {
    // let / var / annotations / inference
    let a: Int = 7
    var b = 2.5
    b *= 2
    let flag = a > 5 && !(b < 1.0)
    println("a={a} b={b} flag={flag}")

    // if as an expression, match with ranges and guards
    let parity = if a % 2 == 0 { "even" } else { "odd" }
    println("{a} is {parity}; classify: {classify(0)}, {classify(7)}, {classify(-3)}, {classify(42)}")
    println("grades: {grade(95)} {grade(85)} {grade(72)} {grade(10)}")

    // loops: while, loop/break, for-in range and list, continue
    var n = 0
    loop {
        n += 1
        if n == 3 { continue }
        if n > LIMIT { break }
        print("{n} ")
    }
    println()
    var countdown = 3
    while countdown > 0 {
        print("{countdown}... ")
        countdown -= 1
    }
    println("go!")

    // strings
    let s = "Hello, World"
    println("len={s.len} upper={s.to_upper()} lower={s |> to_lower} first={s[0]} last={s[-1]} slice={s[7..12]}")
    println("contains World? {s.contains("World")}  find 'o' = {s.find("o")}  replace: {s.replace("World", "Kiln")}")
    let csv = "3,1,4,1,5"
    var total = 0
    for part in csv.split(",") { total += parse_int(part) }
    println("sum of {csv} = {total}")
    var chars = 0
    for c in "kiln" { chars += 1 }
    println("chars in kiln: {chars}, repeat: {"ab".repeat(3)}")

    // numbers & casts
    let x = 10
    let y = 3
    println("int div {x / y}, mod {x % y}, neg div {-7 / 2}, float div {x as Float / y as Float:.4f}")
    println("hex {255:x}, bin {5:b}, padded [{42:>6}] [{42:<6}] [{42:06}] [{"hi":^6}]")
    println("area(2) = {area(2.0):.3f}, sqrt(2) = {sqrt(2.0)}, abs(-4) = {abs(-4)}, 1e3 = {1e3}")
    println("first_even = {first_even([1, 3, 8, 5])}, safe_div(7, 0) = {safe_div(7, 0)}")

    // 64-bit integers wrap on overflow (like C with -fwrapv)
    let big = 9223372036854775807
    println("max int = {big}, max + 1 = {big + 1}")
    println("classify was called {calls} times")
}
