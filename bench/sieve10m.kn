// Benchmark: Sieve of Eratosthenes up to 10,000,000
fn main() {
    let n = 10_000_000
    var is_prime = fill(n + 1, true)
    is_prime[0] = false
    is_prime[1] = false
    var i = 2
    while i * i <= n {
        if is_prime[i] {
            var j = i * i
            while j <= n {
                is_prime[j] = false
                j += i
            }
        }
        i += 1
    }
    var count = 0
    for k in 0..=n {
        if is_prime[k] { count += 1 }
    }
    println("primes up to {n}: {count}")
}
